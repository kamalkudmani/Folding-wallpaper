<?xml version="1.0" encoding="utf-8"?>
<!-- Packs can be large and private by default; they are never sent to cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="packs/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>

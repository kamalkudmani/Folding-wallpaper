{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foldmotion.app/schema/foldpack-manifest.v1.json",
  "title": "FoldPack manifest, schema version 1",
  "description": "manifest.json at the root of a FoldPack. Mirrors com.foldmotion.core.pack.FoldPackManifest; FoldPackValidator adds the checks JSON Schema cannot express (files exist, checksums match, images are WebP of the declared size, motion never exposes the background). Renderer 2 adds springs, reveals, particle bursts (motion/*.json) and ambient motion (motion/ambient.json); packs that need them declare rendererVersion.min = 2. Renderer 3 adds fold styles: per-track delay/span, BOOK, TILES and SWEEP reveals, STREAK and RISE particles; such packs declare rendererVersion.min = 3. Renderer 4 adds video scenes (video section, an MP4 clip); such packs declare rendererVersion.min = 4, drawn packs declare 3.",
  "type": "object",
  "required": [
    "schemaVersion",
    "assetType",
    "id",
    "title",
    "createdAt",
    "creationSource",
    "profileIds",
    "scenes",
    "transitions",
    "previews",
    "colors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "assetType": {
      "const": "FOLD_LIVE_WALLPAPER"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,120}$"
    },
    "packageVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "title": {
      "type": "object",
      "required": [
        "ar",
        "en"
      ],
      "properties": {
        "ar": {
          "type": "string",
          "maxLength": 80
        },
        "en": {
          "type": "string",
          "maxLength": 80
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "creationSource": {
      "enum": [
        "LOCAL_PROCEDURAL",
        "CLOUD_AI",
        "UPLOAD",
        "LOCAL_VIDEO"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "license": {
      "type": "string",
      "default": "PERSONAL_USE"
    },
    "contentRating": {
      "type": "string",
      "default": "EVERYONE"
    },
    "profileIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "description": "Device profiles the pack was composed for, e.g. samsung_z_fold7."
    },
    "rendererVersion": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      },
      "default": {
        "min": 3,
        "max": 4
      }
    },
    "isStaticOnly": {
      "const": false,
      "description": "Static-only packs are rejected; the field exists so an upload can state it honestly."
    },
    "motionIntensity": {
      "enum": [
        "STATIC_END",
        "LOW",
        "MEDIUM"
      ],
      "default": "LOW"
    },
    "scenes": {
      "type": "object",
      "required": [
        "cover",
        "main"
      ],
      "properties": {
        "cover": {
          "$ref": "#/$defs/scene"
        },
        "main": {
          "$ref": "#/$defs/scene"
        }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "object",
      "required": [
        "open",
        "close"
      ],
      "properties": {
        "open": {
          "$ref": "#/$defs/transitionRef"
        },
        "close": {
          "$ref": "#/$defs/transitionRef"
        }
      },
      "additionalProperties": false
    },
    "previews": {
      "type": "object",
      "required": [
        "cover",
        "main"
      ],
      "properties": {
        "cover": {
          "$ref": "#/$defs/path"
        },
        "main": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "colors": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "tertiary",
        "background"
      ],
      "properties": {
        "primary": {
          "$ref": "#/$defs/hex"
        },
        "secondary": {
          "$ref": "#/$defs/hex"
        },
        "tertiary": {
          "$ref": "#/$defs/hex"
        },
        "background": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "generation": {
      "type": [
        "object",
        "null"
      ],
      "description": "Recipe for reproducing or auditing a generated pack. Never contains the prompt text.",
      "properties": {
        "provider": {
          "type": "string"
        },
        "providerVersion": {
          "type": "string"
        },
        "seed": {
          "type": "integer"
        },
        "family": {
          "type": [
            "string",
            "null"
          ]
        },
        "promptSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "enum": [
            "CUSTOM",
            "RANDOM"
          ]
        },
        "paletteSource": {
          "enum": [
            "CURATED",
            "REFERENCE_IMAGE"
          ],
          "default": "CURATED"
        }
      },
      "required": [
        "provider",
        "providerVersion",
        "seed"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      },
      "maxItems": 20
    },
    "ambient": {
      "type": [
        "string",
        "null"
      ],
      "description": "Path of motion/ambient.json: what keeps moving between folds (twinkling stars, glints, fireflies, drifting sand, flowing light, halo).",
      "$ref": "#/$defs/path"
    },
    "motionStyle": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "UNFOLD",
        "BOOK",
        "RISE",
        "WARP",
        "TILES",
        "SWEEP",
        "IRIS",
        null
      ],
      "description": "Fold style of motion/open.json and motion/close.json. AUTO is resolved before writing and never stored."
    },
    "video": {
      "type": [
        "object",
        "null"
      ],
      "description": "v4: the scene is a looping video. One clip feeds both screens: the main screen shows the main window, the cover a slice of it at the same physical scale. Scene layers hold one poster frame per screen.",
      "required": [
        "file",
        "width",
        "height",
        "durationMs",
        "crop",
        "sizeBytes"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/path",
          "description": "MP4 (H.264 or HEVC); sound is ignored."
        },
        "width": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 16,
          "maximum": 8192
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "frameRate": {
          "type": "number",
          "minimum": 1,
          "maximum": 240,
          "default": 30
        },
        "loopCrossfadeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "default": 700,
          "description": "Cross-fade at the loop seam; 0 for clips made to loop. At most half the duration."
        },
        "crop": {
          "type": "object",
          "required": [
            "cover",
            "main"
          ],
          "properties": {
            "cover": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "main": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "description": "Window of the video each screen shows, normalised [l,t,r,b], top-left origin."
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 83886080
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "maxLength": 120,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+){0,2}$",
      "description": "Relative path inside the pack. No absolute paths, no '..', at most three segments."
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "unitRect": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": -0.5,
        "maximum": 1.5
      },
      "description": "[left, top, right, bottom] in the normalised frame of the screen; values outside 0..1 are overscan."
    },
    "scene": {
      "type": "object",
      "required": [
        "baseWidth",
        "baseHeight",
        "focus",
        "layers"
      ],
      "properties": {
        "baseWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "baseHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "focus": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "safeZone": {
          "$ref": "#/$defs/unitRect"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "description": "Back to front. The first layer must be opaque and cover the frame.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path",
              "width",
              "height",
              "rect",
              "depth"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]{1,24}$"
              },
              "path": {
                "$ref": "#/$defs/path"
              },
              "width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "rect": {
                "$ref": "#/$defs/unitRect"
              },
              "depth": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "opaque": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "world": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": -10,
            "maximum": 10
          },
          "description": "World rect [l,t,r,b] shown by this screen, so ambient motion lines up across screens."
        }
      }
    },
    "transitionRef": {
      "type": "object",
      "required": [
        "file",
        "durationMs"
      ],
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 250,
          "maximum": 1800
        }
      }
    }
  }
}
